# Promoted to a real "stack" label in Loki by docker-grafana-stack's Alloy
# config - see that repo's README. Use this stack's own name so it's
# actually distinguishable from the others in Grafana.
MONITORING_STACK=vscode

# Network Configuration
NETWORK=traefik

# code-server Configuration
#VSCODE_VER=latest
#TZ=Australia/Brisbane
PUID=1000
PGID=1000

# Traefik Configuration (required by docker-compose.traefik.yml)
VSCODE_HOST=vscode.example.com
